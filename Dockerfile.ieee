FROM python:3.11-slim

WORKDIR /app

COPY requirements-ieee.txt .
COPY .docker-wheelhouse/ /wheelhouse/

RUN pip install --no-cache-dir /wheelhouse/psutil-*.whl && \
    pip install --no-cache-dir --default-timeout=300 --retries=10 -r requirements-ieee.txt

COPY src/ ./src/
COPY models/ieee_cis/ ./models/ieee_cis/
COPY feature_repo/feature_repo/ ./feature_repo/feature_repo/

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "src.ieee_api:app", "--host", "0.0.0.0", "--port", "8000"]
